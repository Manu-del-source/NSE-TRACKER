generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DELISTED
}

enum InvestorType {
  INDIVIDUAL
  INSTITUTION
  GOVERNMENT
  CUSTODIAN
  OTHER
}

enum SourceType {
  NSE_ANNOUNCEMENT
  CMA_NOTICE
  ISSUER_ANNUAL_REPORT
  ISSUER_ANNOUNCEMENT
  CDSC_PUBLICATION
  LICENSED_MARKET_DATA
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum OwnershipEventType {
  ACQUISITION
  DISPOSAL
  INCREASE
  DECREASE
  NEW_DISCLOSURE
  CORRECTION
  OTHER
}

enum InsiderTransactionType {
  BUY
  SELL
  AWARD
  TRANSFER
  OTHER
}

enum SignalType {
  BUYING_PRESSURE
  SELLING_PRESSURE
  UNUSUAL_VOLUME
  PRICE_MOMENTUM
  VOLATILITY
}

enum SignalMethod {
  RULE_BASED
  STATISTICAL
  MODEL_DERIVED
}

enum AlertRuleType {
  PRICE_ABOVE
  PRICE_BELOW
  PRICE_CHANGE_PERCENT
  OWNERSHIP_DISCLOSURE
  INSIDER_DISCLOSURE
}

model Company {
  id          String        @id @default(cuid())
  symbol      String        @unique
  name        String
  exchange    String        @default("NSE")
  sector      String?
  industry    String?
  website     String?
  status      CompanyStatus @default(ACTIVE)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  quotes              MarketQuote[]
  ownershipEvents     OwnershipEvent[]
  shareholdings       ShareholdingSnapshot[]
  insiderDisclosures  InsiderDisclosure[]
  marketSignals       MarketSignal[]
  watchlistEntries    WatchlistEntry[]
  alertRules          AlertRule[]

  @@index([name])
  @@index([sector])
  @@index([status])
}

model MarketQuote {
  id             String   @id @default(cuid())
  companyId      String
  tradingDate    DateTime @db.Date
  currency       String   @default("KES")
  openPrice      Decimal? @db.Decimal(20, 6)
  highPrice      Decimal? @db.Decimal(20, 6)
  lowPrice       Decimal? @db.Decimal(20, 6)
  closePrice     Decimal? @db.Decimal(20, 6)
  adjustedClose  Decimal? @db.Decimal(20, 6)
  volume         BigInt?
  turnover       Decimal? @db.Decimal(24, 2)
  sourceDocumentId String?
  createdAt      DateTime @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([companyId, tradingDate])
  @@index([tradingDate])
  @@index([companyId, tradingDate])
}

model MarketIndex {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  exchange    String   @default("NSE")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  observations MarketIndexObservation[]
}

model MarketIndexObservation {
  id             String   @id @default(cuid())
  marketIndexId  String
  observationDate DateTime @db.Date
  value          Decimal  @db.Decimal(20, 6)
  change         Decimal? @db.Decimal(20, 6)
  changePercent  Decimal? @db.Decimal(12, 6)
  sourceDocumentId String?
  createdAt      DateTime @default(now())

  marketIndex    MarketIndex    @relation(fields: [marketIndexId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@unique([marketIndexId, observationDate])
  @@index([observationDate])
}

model Investor {
  id             String       @id @default(cuid())
  displayName    String
  normalizedName String
  investorType   InvestorType @default(OTHER)
  countryCode    String?
  publicProfile  String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  institution          Institution?
  ownershipEvents      OwnershipEvent[]
  shareholdings        ShareholdingSnapshot[]
  insiderDisclosures   InsiderDisclosure[]

  @@index([normalizedName])
  @@index([investorType])
}

model Institution {
  id          String   @id @default(cuid())
  investorId  String   @unique
  legalName   String
  institutionType String?
  countryCode String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([legalName])
}

model ShareholdingSnapshot {
  id               String   @id @default(cuid())
  companyId        String
  investorId       String
  asOfDate         DateTime @db.Date
  sharesHeld       BigInt?
  ownershipPercent Decimal? @db.Decimal(12, 6)
  shareClass       String?
  sourceDocumentId String
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  investor       Investor       @relation(fields: [investorId], references: [id], onDelete: Restrict)
  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@unique([companyId, investorId, asOfDate, shareClass])
  @@index([companyId, asOfDate])
  @@index([investorId, asOfDate])
  @@index([verificationStatus])
}

model OwnershipEvent {
  id                 String             @id @default(cuid())
  companyId          String
  investorId         String
  eventType          OwnershipEventType
  effectiveDate      DateTime?          @db.Date
  disclosedAt        DateTime?
  sharesBefore       BigInt?
  sharesAfter        BigInt?
  sharesChanged      BigInt?
  percentageBefore   Decimal?           @db.Decimal(12, 6)
  percentageAfter    Decimal?           @db.Decimal(12, 6)
  percentageChanged  Decimal?           @db.Decimal(12, 6)
  shareClass         String?
  sourceDocumentId   String
  verificationStatus VerificationStatus @default(PENDING)
  verificationNotes  String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  investor       Investor       @relation(fields: [investorId], references: [id], onDelete: Restrict)
  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@index([companyId, effectiveDate])
  @@index([investorId, effectiveDate])
  @@index([verificationStatus, disclosedAt])
}

model InsiderDisclosure {
  id                 String                @id @default(cuid())
  companyId          String
  personInvestorId   String
  transactionType    InsiderTransactionType
  transactionDate    DateTime?             @db.Date
  disclosedAt        DateTime?
  shares             BigInt?
  pricePerShare      Decimal?              @db.Decimal(20, 6)
  currency           String                @default("KES")
  sourceDocumentId   String
  verificationStatus VerificationStatus    @default(PENDING)
  notes              String?
  verifiedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  person         Investor       @relation(fields: [personInvestorId], references: [id], onDelete: Restrict)
  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  @@index([companyId, transactionDate])
  @@index([personInvestorId, transactionDate])
  @@index([verificationStatus, disclosedAt])
}

model SourceDocument {
  id             String     @id @default(cuid())
  sourceType     SourceType
  publisher      String
  title          String
  sourceUrl      String?
  externalId     String?
  checksum       String?    @unique
  publishedAt    DateTime?
  documentDate   DateTime?  @db.Date
  retrievedAt    DateTime   @default(now())
  storageKey     String?
  extractedText  String?
  metadata       Json?
  createdAt      DateTime   @default(now())

  marketQuotes           MarketQuote[]
  indexObservations      MarketIndexObservation[]
  shareholdingSnapshots  ShareholdingSnapshot[]
  ownershipEvents        OwnershipEvent[]
  insiderDisclosures     InsiderDisclosure[]
  marketSignals          MarketSignal[]

  @@index([sourceType, publishedAt])
  @@index([publisher, documentDate])
}

model MarketSignal {
  id              String       @id @default(cuid())
  companyId       String
  signalType      SignalType
  method          SignalMethod
  calculatedAt    DateTime     @default(now())
  windowStart     DateTime?
  windowEnd       DateTime?
  score           Decimal?     @db.Decimal(12, 6)
  summary         String
  methodology     String
  inputSnapshot   Json?
  disclaimer      String       @default("Analytical estimate based on market data; not an identified buyer or seller.")
  sourceDocumentId String?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([companyId, calculatedAt])
  @@index([signalType, calculatedAt])
}

model WatchlistEntry {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId, createdAt])
}

model AlertRule {
  id          String         @id @default(cuid())
  userId      String
  ruleType    AlertRuleType
  symbol      String?
  threshold   Decimal?       @db.Decimal(12, 6)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, isActive, createdAt])
  @@index([symbol, ruleType])
}
